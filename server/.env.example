# ==============================================================================
# YourTube Backend Environment Variables
# For Render deployment, configure these in Render Dashboard -> Environment
# ==============================================================================

# Server Port (Render sets this automatically in production, defaults to 5000)
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/youtube?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/youtube?retryWrites=true&w=majority
# DB_URL is also supported as an alias:
DB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/youtube?retryWrites=true&w=majority

# Production Frontend URL on Vercel (used for CORS and cookies)
# Example: https://yourtube-frontend.vercel.app
FRONTEND_URL=https://YOUR_VERCEL_APP.vercel.app

# ── Cloudinary Persistent Video Storage ──────────────────────────────────────
# Free account at https://cloudinary.com
# Videos uploaded by any user will be permanently stored on Cloudinary CDN
# and remain accessible across all devices and redeployments.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Razorpay Payment Gateway (Test Mode) ─────────────────────────────────────
# From https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ── Email Service (Gmail SMTP for Multi-Factor Login OTP) ───────────────────
# Generate an App Password at https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
